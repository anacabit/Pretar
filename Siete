function setFotoMode(tipo,m,el){
  if(tipo==="foto"){
    S.fotoMode=m;
    document.querySelectorAll("#fotoOptDrive,#fotoOptFile,#fotoOptUrl,#fotoOptNone").forEach(f=>f.classList.remove("on"));
    el.classList.add("on");
    ["fotoBlockDrive","fotoBlockFile","fotoBlockUrl"].forEach(id=>document.getElementById(id).style.display="none");
    if(m!=="none") document.getElementById("fotoBlock"+m.charAt(0).toUpperCase()+m.slice(1)).style.display="block";
    if(m==="none"){S.fotoSrc=null;updatePreviews();}
  } else {
    S.logoMode=m;
    document.querySelectorAll("#logoOptDrive,#logoOptFile,#logoOptUrl,#logoOptNone").forEach(f=>f.classList.remove("on"));
    el.classList.add("on");
