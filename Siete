/* LIGHTBOX */
let _lbFotos=[],_lbIdx=0,_lbTouchX=0;
function abrirLightbox(idx){
  _lbFotos=S.galFotos.filter(f=>f!==null);
  if(!_lbFotos.length) return;
  _lbIdx=idx;
  actualizarLightbox();
  document.getElementById("lightbox").classList.add("show");
  document.body.style.overflow="hidden";
  // swipe táctil
  const lb=document.getElementById("lightbox");
  lb.ontouchstart=e=>{_lbTouchX=e.touches[0].clientX;};
  lb.ontouchend=e=>{
    const dx=e.changedTouches[0].clientX-_lbTouchX;
    if(Math.abs(dx)>40) lbNav(dx<0?1:-1);
  };
}
function cerrarLightbox(){
  document.getElementById("lightbox").classList.remove("show");
  document.body.style.overflow="";
}
function lbNav(dir){
  _lbIdx=(_lbIdx+dir+_lbFotos.length)%_lbFotos.length;
  actualizarLightbox();
}
function actualizarLightbox(){
  document.getElementById("lbImg").src=_lbFotos[_lbIdx];
  const dots=document.getElementById("lbDots");
  dots.innerHTML=_lbFotos.map((_,i)=>`<div class="lb-dot${i===_lbIdx?' on':''}" onclick="lbIdx=${i};actualizarLightbox()"></div>`).join("");
  document.getElementById("lbPrev").style.display=_lbFotos.length>1?"block":"none";
  document.getElementById("lbNext").style.display=_lbFotos.length>1?"block":"none";
}

