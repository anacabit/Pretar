function cargarDrive(tipo){
  const input=tipo==="foto"?"driveLinkFoto":"driveLinkLogo";
  const url=document.getElementById(input).value.trim();
  let fileId="";
  const m1=url.match(/\/file\/d\/([^\/\?]+)/);
  const m2=url.match(/id=([^&]+)/);
  if(m1) fileId=m1[1];
  else if(m2) fileId=m2[1];
  if(fileId){
    const src=`https://drive.google.com/thumbnail?id=${fileId}&sz=w400`;
    if(tipo==="foto") S.fotoSrc=src;
    else S.logoSrc=src;
    updatePreviews();
    status("st1","✅ "+(tipo==="foto"?"Foto":"Logo")+" cargado desde Drive");
  } else {
    status("st1","⚠️ Link de Drive no válido");
  }
}

function cargarFile(tipo,input){
  const file=input.files[0];
  if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    if(tipo==="foto") S.fotoSrc=e.target.result;
    else S.logoSrc=e.target.result;
    updatePreviews();renderAll();
  };
  reader.readAsDataURL(file);
}

function cargarURL(tipo){
  const url=tipo==="foto"?document.getElementById("urlFoto").value.trim():document.getElementById("urlLogo").value.trim();
  if(!url) return;
  if(tipo==="foto") S.fotoSrc=url;
