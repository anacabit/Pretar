/* Construir slots de galeria */
function buildGalSlots(){
  const g=document.getElementById("galSlots");
  if(!g) return;
  g.innerHTML="";

  // input file oculto — uno solo reutilizable
  let inp=document.getElementById("galFileInput");
  if(!inp){
    inp=document.createElement("input");
    inp.type="file";
    inp.accept="image/*";
    inp.id="galFileInput";
    inp.style.display="none";
    document.body.appendChild(inp);
  }

  for(let i=0;i<6;i++){
    const slot=document.createElement("div");
    slot.id="galSlot"+i;

    if(S.galFotos[i]){
      // Foto cargada — mostrar imagen grande con botones
      slot.style.cssText="position:relative;border-radius:10px;overflow:hidden;border:2px solid #0f9d58;background:#000;";
      slot.innerHTML=`
        <img src="${S.galFotos[i]}" style="width:100%;height:110px;object-fit:cover;display:block;border-radius:8px">
        <div style="position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:flex-end;justify-content:space-between;padding:6px;background:linear-gradient(transparent 50%,rgba(0,0,0,.55))">
          <div style="font-size:9px;color:rgba(255,255,255,.85);font-weight:600">Foto ${i+1}</div>
          <div style="display:flex;gap:4px">
            <button onclick="event.stopPropagation();abrirGalInput(${i})" style="background:rgba(255,255,255,.25);border:none;border-radius:5px;color:#fff;font-size:10px;padding:3px 7px;cursor:pointer;font-weight:700">✏️ Cambiar</button>
            <button onclick="event.stopPropagation();quitarGalFoto(${i})" style="background:rgba(220,50,50,.75);border:none;border-radius:5px;color:#fff;font-size:10px;padding:3px 7px;cursor:pointer;font-weight:700">✕</button>
          </div>
        </div>`;
    } else {
      // Slot vacío — botón grande y claro
      slot.style.cssText="border-radius:10px;overflow:hidden;border:2px dashed #f57c00;background:#fff8f0;height:110px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;";
      slot.innerHTML=`
        <div style="font-size:28px">📷</div>
        <div style="font-size:10px;font-weight:700;color:#f57c00">Foto ${i+1}</div>
        <div style="font-size:9px;color:#aaa;text-align:center;padding:0 8px">Tocar para<br>elegir foto</div>`;
      slot.onclick=()=>abrirGalInput(i);
    }

    g.appendChild(slot);
  }
}

let _galIdx=0;
function abrirGalInput(i){
  _galIdx=i;
  const inp=document.getElementById("galFileInput");
  inp.onchange=(e)=>{
    const file=e.target.files[0];
    if(!file) return;
    const reader=new FileReader();
    reader.onload=ev=>{S.galFotos[_galIdx]=ev.target.result;buildGalSlots();renderAll();};
    reader.readAsDataURL(file);
    inp.value="";
  };
  inp.click();
}

function quitarGalFoto(i){
  S.galFotos[i]=null;
  buildGalSlots();
  renderAll();
}

