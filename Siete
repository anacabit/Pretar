<script>
/* LOGIN */
const USERS=[{user:"admin",pass:"LAqueES26$"},{user:"mitarjeta",pass:"LAqueES26$"}];
let loginTries=0,lockUntil=0;

function doLogin(){
  const now=Date.now();
  if(now<lockUntil){document.getElementById("loginErr").textContent=`Bloqueado. Espera ${Math.ceil((lockUntil-now)/1000)}s`;return;}
  const u=document.getElementById("loginUser").value.trim().toLowerCase();
  const p=document.getElementById("loginPass").value;
  if(USERS.find(x=>x.user===u&&x.pass===p)){
    loginTries=0;
    const ls=document.getElementById("loginScreen");
    ls.style.transition="opacity .4s";ls.style.opacity="0";
    setTimeout(()=>{ls.style.display="none";document.getElementById("appContent").style.display="block";renderAll();},400);
  } else {
    loginTries++;
    if(loginTries>=3){
      lockUntil=Date.now()+30000;
      const iv=setInterval(()=>{const s=Math.ceil((lockUntil-Date.now())/1000);if(s<=0){clearInterval(iv);document.getElementById("loginErr").textContent="Puedes intentar de nuevo.";loginTries=0;}else document.getElementById("loginErr").textContent=`Bloqueado ${s}s`;},1000);
    } else {
