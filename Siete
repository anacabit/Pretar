  const fg=document.getElementById("qrFg")?document.getElementById("qrFg").value:"#000000";
  const bg=document.getElementById("qrBg")?document.getElementById("qrBg").value:"#ffffff";
  const sz=size||90;
  try {
    new QRCode(box, {
      text: url,
      width: sz,
      height: sz,
      colorDark: fg,
      colorLight: bg,
      correctLevel: QRCode.CorrectLevel.H
    });
    setTimeout(()=>{
      const img=box.querySelector("img");
      const cv=box.querySelector("canvas");
      if(cv) cv.style.display="none";
      if(img){
        img.style.cssText=`display:block;width:${sz}px;height:${sz}px;border-radius:8px;image-rendering:pixelated`;
