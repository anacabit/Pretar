      inp.id="webSec_servicios";inp.style.cssText="width:100%;font-size:10.5px;border-radius:6px;border:1px solid #ddd;padding:5px 7px;background:#fff";
      inp.placeholder="Limpieza, Blanqueamiento, Ortodoncia...";
      inp.oninput=()=>renderAll();
      inp.value=document.getElementById("fSvcs")?document.getElementById("fSvcs").value:"";
      wrap.appendChild(inp);
    } else if(k==="galeria"){
      const note=document.createElement("div");
      note.style.cssText="font-size:9px;color:#aaa";
      note.textContent="Las fotos se cargan en la sección Galería de fotos arriba";
      wrap.appendChild(note);
    } else if(k==="contacto"){
      const note=document.createElement("div");
      note.style.cssText="font-size:9px;color:#aaa";
      note.textContent="Usa los datos de la sección 5 · Contacto";
      wrap.appendChild(note);
    } else if(k==="qr"){
      const note=document.createElement("div");
      note.style.cssText="font-size:9px;color:#aaa";
      note.textContent="Muestra el QR configurado en la sección 6";
      wrap.appendChild(note);
    } else if(k==="ubicacion"){
      const inp=document.createElement("input");
      inp.id="webSec_ubicacion";inp.style.cssText="width:100%;font-size:10.5px;border-radius:6px;border:1px solid #ddd;padding:5px 7px;background:#fff";
      inp.placeholder="Dirección o referencia de ubicación...";
      inp.oninput=()=>renderAll();
      wrap.appendChild(inp);
    }
    g.appendChild(wrap);
  });
}

function setQR(type,el){
  S.qrType=type;
  document.querySelectorAll(".qr-pill").forEach(p=>p.classList.remove("on"));el.classList.add("on");
  const lbls={wa:"Mensaje de WhatsApp",perfil:"URL de perfil o web",vcard:"Número para guardar contacto"};
  document.getElementById("qrLbl").textContent=lbls[type];
  renderAll();
}

function setTxt(v,el){
  S.txt=v;
  document.getElementById("txtW").classList.toggle("on",v==="white");
  document.getElementById("txtD").classList.toggle("on",v==="dark");
  renderAll();
}

function setMode(m,el){
  S.mode=m;
  document.querySelectorAll(".mode-tab").forEach(t=>t.classList.remove("on"));el.classList.add("on");
  ["viewCard","viewWeb","viewBoth"].forEach(id=>document.getElementById(id).classList.remove("show"));
  document.getElementById({card:"viewCard",web:"viewWeb",both:"viewBoth"}[m]).classList.add("show");
  renderAll();
}

/* FIX 2 — prevenir cierre de app al tocar/scroll: touch-action en tarjeta */
function fixTouchScroll(){
  // Evitar que toques en la tarjeta disparen scroll del documento padre
  const cardWrap=document.getElementById("cardWrap");
  if(cardWrap){
    cardWrap.addEventListener("touchmove",e=>e.stopPropagation(),{passive:true});
  }
  const stage=document.querySelector(".stage");
  if(stage){
    stage.addEventListener("touchmove",e=>e.stopPropagation(),{passive:true});
  }
  // Prevent body scroll hijacking
  document.body.style.overscrollBehavior="contain";
  document.documentElement.style.overscrollBehavior="contain";
}

